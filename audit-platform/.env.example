# Supabase (Project settings > API). The publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://mexyzyoyhyigrkposhmu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic API key (server only). Required for the AI pipeline.
ANTHROPIC_API_KEY=
# Optional: model and effort. Defaults: claude-opus-5-5 (Claude Opus 5.5), high.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high

# Optional: public URL used in confirmation and reset emails, and the firm name on exports.
NEXT_PUBLIC_SITE_URL=
FIRM_NAME=

# Pipeline execution. "inline" runs each AI step inside the request (Vercel, local).
# "background" hands it to netlify/functions/pipeline-background (Netlify; up to 15 minutes).
# Defaults to background on Netlify. The job secret signs the hand-off; generate a long random value.
PIPELINE_MODE=
PIPELINE_JOB_SECRET=
