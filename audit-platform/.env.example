# Supabase (Project settings > API). The publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://mexyzyoyhyigrkposhmu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Anthropic API key (server only). Required for the AI pipeline.
ANTHROPIC_API_KEY=
# Optional: model and effort. Defaults: claude-opus-5, high.
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=high

# Optional: public URL used in confirmation and reset emails, and the firm name on exports.
NEXT_PUBLIC_SITE_URL=
FIRM_NAME=
